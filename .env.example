# Firebase web configuration.
# Copy this file to .env.local and fill in the values from the Firebase console
# (Project settings -> General -> Your apps -> SDK setup and configuration).
#
# These values are public by design and ship in the client bundle. They are not
# secrets. Real authorization lives in Firestore Security Rules and in the
# privileged Cloud Functions.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
