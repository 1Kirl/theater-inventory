# Firebase web configuration.
# Copy this file to .env.local and fill in the values from the Firebase console
# (Project settings -> General -> Your apps -> SDK setup and configuration).
#
# These values are public by design and ship in the client bundle. They are not
# secrets. Real authorization lives in Firestore Security Rules, which are the
# only authorization boundary: this project runs on the Spark plan and has no
# server code.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check.
#
# Required for the production build only. This is the reCAPTCHA Enterprise site
# key registered for the web app under App Check. Like the values above it is
# embedded in the page by design and is not a secret. Enforcement is on, so a
# production build without it has every AI Logic request rejected.
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Optional, development only. Leave empty and the SDK generates a debug token on
# first load and logs it, which is what you register in the console. Set it to
# pin a token that is already registered — useful for a second browser profile,
# which otherwise generates a token of its own.
#
# Unlike the keys above, a debug token IS a secret: it lets any caller pass
# App Check for this project. Keep it in the untracked .env.local only, and
# revoke it in the console when you are done with it.
VITE_APP_CHECK_DEBUG_TOKEN=
