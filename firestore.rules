rules_version = '2';

// Theater Inventory Tracker — Firestore Security Rules
//
// This project runs on the Firebase Spark plan. There are no Cloud Functions and
// no Admin SDK, so every write originates in the browser and these rules are the
// only authorization boundary. An invariant that is not expressed here is not
// enforced anywhere.
//
// Everything not explicitly allowed is denied by the final rule.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function orgPath(organizationId) {
      return /databases/$(database)/documents/organizations/$(organizationId);
    }

    function membershipPath(organizationId, memberUid) {
      return /databases/$(database)/documents/organization_memberships/$(organizationId + '_' + memberUid);
    }

    function codePath(code) {
      return /databases/$(database)/documents/organization_join_codes/$(code);
    }

    function settingsPath(organizationId) {
      return /databases/$(database)/documents/organization_admin_settings/$(organizationId);
    }

    function proofPath(organizationId, memberUid) {
      return /databases/$(database)/documents/organization_membership_join_proofs/$(organizationId + '_' + memberUid);
    }

    // A code is interpolated into a document path, so its shape is checked
    // first. Without this, a crafted value could change which document a get()
    // resolves to. Mirrors JOIN_CODE_ALPHABET in src/domain/join-code.ts.
    function isCodeShape(code) {
      return code is string && code.matches('^[A-HJ-NP-Z2-9]{16}$');
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // Reject documents carrying fields the model does not define. Unknown fields
    // are how a schema quietly drifts away from what the rules actually check.
    function hasExactly(required, optional) {
      return request.resource.data.keys().hasAll(required)
        && request.resource.data.keys().hasOnly(required.concat(optional));
    }

    // Path B — the organization already exists and names the caller as Admin.
    function isAdminOf(organizationId) {
      return isSignedIn()
        && exists(orgPath(organizationId))
        && get(orgPath(organizationId)).data.admin_uid == uid();
    }

    // Path A — the organization is being created in this same atomic write and
    // will name the caller as Admin. At this moment there is no Admin yet, so
    // there is nothing for isAdminOf() to read.
    function isCreatingOrganization(organizationId) {
      return isSignedIn()
        && existsAfter(orgPath(organizationId))
        && getAfter(orgPath(organizationId)).data.admin_uid == uid()
        && getAfter(orgPath(organizationId)).data.created_by_uid == uid();
    }

    function isActiveMemberOf(organizationId) {
      return isSignedIn()
        && exists(membershipPath(organizationId, uid()))
        && get(membershipPath(organizationId, uid())).data.is_active == true;
    }

    /**
     * The four things a member may say about themselves here.
     *
     * Each is optional and each is bounded, because all four are rendered on a
     * card somebody else reads. Angle brackets are refused outright: nothing in
     * this product renders them as markup, and a name or a biography has no use
     * for one.
     */
    function profileTextValid(field, maxLength) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string
            && request.resource.data[field].size() > 0
            && request.resource.data[field].size() <= maxLength
            && !request.resource.data[field].matches('.*[<>].*'));
    }

    function profileFieldsValid() {
      return profileTextValid('profile_display_name', 60)
        && profileTextValid('profile_phone', 40)
        && profileTextValid('profile_contact_email', 254)
        && profileTextValid('profile_bio', 300);
    }

    function hasActiveMembership(organizationId, memberUid) {
      return exists(membershipPath(organizationId, memberUid))
        && get(membershipPath(organizationId, memberUid)).data.is_active == true;
    }

    function permissionKeysExact(permissions) {
      return permissions.keys().hasOnly(['inventory', 'maintenance', 'productions', 'calendar'])
        && permissions.keys().hasAll(['inventory', 'maintenance', 'productions', 'calendar']);
    }

    function permissionsAllNone(permissions) {
      return permissionKeysExact(permissions)
        && permissions.inventory == 'none'
        && permissions.maintenance == 'none'
        && permissions.productions == 'none'
        && permissions.calendar == 'none';
    }

    function permissionsValid(permissions) {
      return permissionKeysExact(permissions)
        && permissions.inventory in ['none', 'view', 'edit']
        && permissions.maintenance in ['none', 'view', 'edit']
        && permissions.productions in ['none', 'view', 'edit']
        && permissions.calendar in ['none', 'view', 'edit'];
    }

    // ------------------------------------------------------------------ users

    match /users/{userUid} {

      // Member lists and assignee pickers need display names. A profile holds
      // no sensitive data: no email, no credentials.
      allow get: if isSignedIn();

      // Enumeration is denied. Reaching a profile requires already holding the
      // uid, which comes from a membership the caller is authorized to read.
      allow list: if false;

      allow create: if isSignedIn()
        && hasExactly(['uid', 'user_id', 'display_name', 'created_at', 'updated_at'], [])
        && userUid == uid()
        && request.resource.data.uid == userUid
        && request.resource.data.user_id is string
        && request.resource.data.user_id.size() > 0
        && request.resource.data.display_name is string
        && request.resource.data.display_name.size() > 0
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time;

      allow update: if isSignedIn()
        && userUid == uid()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.display_name is string
        && request.resource.data.display_name.size() > 0;

      allow delete: if false;
    }

    // ---------------------------------------------------------- organizations

    match /organizations/{organizationId} {

      // Unassigned members read this too — the waiting screen names the
      // organization. Membership, not assignment, is what grants the read.
      allow get: if isActiveMemberOf(organizationId);

      allow list: if false;

      // Path A. The creator names themselves as Admin and must bring the rest
      // of the batch with them; a lone organization document is rejected.
      allow create: if isSignedIn()
        && hasExactly(
             ['organization_id', 'name', 'admin_uid', 'created_by_uid', 'created_at', 'updated_at'],
             ['description'])
        && request.resource.data.organization_id == organizationId
        && request.resource.data.admin_uid == uid()
        && request.resource.data.created_by_uid == uid()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time
        && existsAfter(membershipPath(organizationId, uid()))
        && existsAfter(settingsPath(organizationId));

      // Exactly two shapes of update are allowed, and never both at once.
      allow update: if isAdminOf(organizationId)
        && request.resource.data.organization_id == resource.data.organization_id
        && request.resource.data.created_by_uid == resource.data.created_by_uid
        && request.resource.data.created_at == resource.data.created_at
        && request.resource.data.updated_at == request.time
        && (
          isAdminTransfer(organizationId)
          || isRename(organizationId)
        );

      allow delete: if false;
    }

    // Transfer writes admin_uid and nothing else. The incoming Admin must
    // already hold an active membership, so an organization can never be handed
    // to someone who is not in it.
    function isAdminTransfer(organizationId) {
      return changedOnly(['admin_uid', 'updated_at'])
        && request.resource.data.admin_uid is string
        && request.resource.data.admin_uid != resource.data.admin_uid
        && hasActiveMembership(organizationId, request.resource.data.admin_uid);
    }

    // A rename must carry the active join code's snapshot with it, because a
    // user validating a code is not yet a member and cannot read this document.
    function isRename(organizationId) {
      return changedOnly(['name', 'updated_at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && exists(settingsPath(organizationId))
        && isCodeShape(get(settingsPath(organizationId)).data.current_join_code_id)
        && getAfter(codePath(get(settingsPath(organizationId)).data.current_join_code_id)).data.organization_name_snapshot
             == request.resource.data.name;
    }

    // --------------------------------------------- organization_memberships

    match /organization_memberships/{membershipId} {

      allow get: if isSignedIn() && (
        resource.data.uid == uid()
        || isActiveMemberOf(resource.data.organization_id)
      );

      // Rules are not filters: a query is rejected outright if any candidate
      // document fails, so the client must constrain it to match. The cheap
      // self clause comes first, then the member directory, then the Admin
      // view which alone may include deactivated members.
      allow list: if isSignedIn() && (
        resource.data.uid == uid()
        || (resource.data.is_active == true && isActiveMemberOf(resource.data.organization_id))
        || isAdminOf(resource.data.organization_id)
      );

      // A new membership always starts empty. Pinning these values here is what
      // stops a joining user from granting themselves access on the way in.
      allow create: if isSignedIn()
        && hasExactly(
             ['organization_id', 'uid', 'team_ids', 'permissions', 'is_active', 'joined_at', 'updated_at'],
             [])
        && membershipId == request.resource.data.organization_id + '_' + request.resource.data.uid
        && request.resource.data.uid == uid()
        && request.resource.data.team_ids == []
        && permissionsAllNone(request.resource.data.permissions)
        && request.resource.data.is_active == true
        && request.resource.data.joined_at == request.time
        && request.resource.data.updated_at == request.time
        && (
          isCreatingOrganization(request.resource.data.organization_id)
          || hasValidJoinProof(request.resource.data.organization_id)
        );

      // Two writers, and neither can do the other's job.
      //
      // The Admin assigns teams, permissions, and activity, and cannot touch
      // anybody's personal details. A member owns how they appear and how they
      // are reached here, and cannot give themselves a team, a permission, or
      // anyone else's membership. Each branch names its own fields, so neither
      // needs to trust the interface that produced the write.
      allow update: if
        (
          isAdminOf(resource.data.organization_id)
          && changedOnly(['team_ids', 'permissions', 'is_active', 'updated_at'])
          && request.resource.data.team_ids is list
          && request.resource.data.is_active is bool
          && permissionsValid(request.resource.data.permissions)
          && request.resource.data.updated_at == request.time
          && (
            request.resource.data.is_active == true
            || resource.data.uid != get(orgPath(resource.data.organization_id)).data.admin_uid
          )
        )
        || (
          // Your own membership, in an organization you are still active in.
          resource.data.uid == uid()
          && request.resource.data.uid == resource.data.uid
          && resource.data.is_active == true
          && changedOnly(['profile_display_name', 'profile_phone', 'profile_contact_email',
                          'profile_bio', 'updated_at'])
          && profileFieldsValid()
          && request.resource.data.updated_at == request.time
        );

      allow delete: if false;
    }

    // The proof is what lets this rule see which code was used. The membership
    // itself never stores it, so a colleague reading the directory learns
    // nothing about how anyone joined.
    function hasValidJoinProof(organizationId) {
      return existsAfter(proofPath(organizationId, uid()))
        && proofIsSound(organizationId, getAfter(proofPath(organizationId, uid())).data);
    }

    function proofIsSound(organizationId, proof) {
      return proof.organization_id == organizationId
        && proof.uid == uid()
        && isCodeShape(proof.join_code_id)
        && exists(codePath(proof.join_code_id))
        && get(codePath(proof.join_code_id)).data.active == true
        && get(codePath(proof.join_code_id)).data.organization_id == organizationId;
    }

    // ----------------------------------------------- organization_join_codes

    match /organization_join_codes/{code} {

      // The joining client has to read this document; there is no server to
      // read it for them. The code is a bearer secret, sized at 2^80. Holding
      // one grants no access on its own: the membership it creates is empty.
      allow get: if isSignedIn();

      // Denied for everyone, which is what prevents codes and organizations
      // from being enumerated.
      allow list: if false;

      allow create: if isSignedIn()
        && hasExactly(
             ['organization_id', 'organization_name_snapshot', 'active', 'created_by_uid', 'created_at'],
             [])
        && isCodeShape(code)
        && request.resource.data.organization_id is string
        && request.resource.data.organization_name_snapshot is string
        && request.resource.data.organization_name_snapshot.size() > 0
        && request.resource.data.active == true
        && request.resource.data.created_by_uid == uid()
        && request.resource.data.created_at == request.time
        && !('revoked_at' in request.resource.data)
        && (
          isCreatingOrganization(request.resource.data.organization_id)
          || isAdminOf(request.resource.data.organization_id)
        );

      allow update: if isAdminOf(resource.data.organization_id)
        && resource.data.active == true
        && (
          isRevocation()
          || isSnapshotFollowingRename(resource.data.organization_id)
        );

      // Revoked codes are kept, so a superseded code fails validation for a
      // clear reason instead of looking like a typo.
      allow delete: if false;
    }

    function isRevocation() {
      return changedOnly(['active', 'revoked_at'])
        && request.resource.data.active == false
        && request.resource.data.revoked_at == request.time;
    }

    function isSnapshotFollowingRename(organizationId) {
      return changedOnly(['organization_name_snapshot'])
        && request.resource.data.organization_name_snapshot
             == getAfter(orgPath(organizationId)).data.name;
    }

    // ------------------------------------------ organization_admin_settings

    match /organization_admin_settings/{organizationId} {

      // Admin-only. This document exists solely to hold something ordinary
      // members must not see, because Firestore cannot restrict reads per field.
      allow get: if isAdminOf(organizationId);
      allow list: if false;

      // Path A only. This document is never created any other way.
      allow create: if isSignedIn()
        && hasExactly(['organization_id', 'current_join_code_id', 'updated_at'], [])
        && request.resource.data.organization_id == organizationId
        && isCodeShape(request.resource.data.current_join_code_id)
        && request.resource.data.updated_at == request.time
        && isCreatingOrganization(organizationId)
        && pointsAtLiveCode(organizationId, request.resource.data.current_join_code_id);

      allow update: if isAdminOf(organizationId)
        && changedOnly(['current_join_code_id', 'updated_at'])
        && isCodeShape(request.resource.data.current_join_code_id)
        && request.resource.data.updated_at == request.time
        && pointsAtLiveCode(organizationId, request.resource.data.current_join_code_id);

      allow delete: if false;
    }

    function pointsAtLiveCode(organizationId, code) {
      return existsAfter(codePath(code))
        && getAfter(codePath(code)).data.organization_id == organizationId
        && getAfter(codePath(code)).data.active == true;
    }

    // ------------------------- organization_membership_join_proofs

    match /organization_membership_join_proofs/{proofId} {

      allow get: if isSignedIn() && (
        resource.data.uid == uid()
        || isAdminOf(resource.data.organization_id)
      );

      allow list: if false;

      allow create: if isSignedIn()
        && hasExactly(['organization_id', 'uid', 'join_code_id', 'created_at'], [])
        && proofId == request.resource.data.organization_id + '_' + request.resource.data.uid
        && request.resource.data.uid == uid()
        && isCodeShape(request.resource.data.join_code_id)
        && request.resource.data.created_at == request.time
        && exists(codePath(request.resource.data.join_code_id))
        && get(codePath(request.resource.data.join_code_id)).data.active == true
        && get(codePath(request.resource.data.join_code_id)).data.organization_id
             == request.resource.data.organization_id
        && existsAfter(membershipPath(request.resource.data.organization_id, uid()));

      // A proof is a historical fact.
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------ teams

    match /teams/{teamId} {

      // Every member reads teams: names appear on membership badges and in the
      // assignment interface. Teams are organization-level, so membership alone
      // grants the read.
      allow get, list: if isActiveMemberOf(resource.data.organization_id);

      allow create: if isAdminOf(request.resource.data.organization_id)
        && hasExactly(['team_id', 'organization_id', 'name', 'created_at', 'updated_at'],
                      ['description'])
        && request.resource.data.team_id == teamId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.created_at == request.time
        && request.resource.data.updated_at == request.time;

      allow update: if isAdminOf(resource.data.organization_id)
        && changedOnly(['name', 'description', 'updated_at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.updated_at == request.time;

      // No hard delete in the MVP: membership.team_ids and, from Phase 3,
      // inventory and maintenance records would be left pointing at nothing.
      allow delete: if false;
    }

    // -------------------------------------------------------- inventory_items

    // Team scope is an editing boundary, not a reading one. The product exists
    // to answer what the organization owns, and an answer limited to one crew's
    // own team would not be an answer. What team scope protects is authorship.

    function membershipData(organizationId) {
      return get(membershipPath(organizationId, uid())).data;
    }

    function inventoryLevel(organizationId) {
      return membershipData(organizationId).permissions.inventory;
    }

    function canViewInventory(organizationId) {
      return isSignedIn() && (
        isAdminOf(organizationId)
        || (isActiveMemberOf(organizationId)
            && inventoryLevel(organizationId) in ['view', 'edit'])
      );
    }

    // Writing needs the module permission and the record's team. Admin skips the
    // team check; a member is held to their own teams, on both the team the item
    // has now and the team they are moving it to.
    function canWriteInventoryForTeam(organizationId, teamId) {
      return isSignedIn() && (
        isAdminOf(organizationId)
        || (isActiveMemberOf(organizationId)
            && inventoryLevel(organizationId) == 'edit'
            && teamId in membershipData(organizationId).team_ids)
      );
    }

    // team_id is required, and the team has to be one of this organization's.
    // Without this an item could name a team from somewhere else and land
    // outside every crew's reach.
    function teamBelongsToOrganization(organizationId, teamId) {
      return teamId is string
        && teamId.size() > 0
        && exists(/databases/$(database)/documents/teams/$(teamId))
        && get(/databases/$(database)/documents/teams/$(teamId)).data.organization_id
             == organizationId;
    }

    function isCount(value) {
      return value is int && value >= 0;
    }

    // Money is whole cents, never a float. The ceiling is $1,000,000.00 for one
    // unit — far above anything a school theater buys, and low enough that a
    // misplaced decimal point or a pasted wrong field is caught here rather than
    // showing up in a production budget.
    function isCostCents(value) {
      return value is int && value >= 0 && value <= 100000000;
    }

    // The twelve MVP categories from PROJECT_SPEC section 7.4. Free text would
    // defeat the category filter this list exists to serve, so anything outside
    // it is rejected rather than quietly stored. Kept in step with
    // INVENTORY_CATEGORIES in src/types/inventory.ts.
    function isAllowedCategory(category) {
      return category in [
        'Lighting Instruments',
        'Cables',
        'Lighting Accessories',
        'Sound Equipment',
        'Microphones',
        'Tools',
        'Set-Building Materials',
        'Platforms / Flats',
        'Props',
        'Costumes',
        'Hardware',
        'Miscellaneous Technical Equipment'
      ];
    }

    function conditionCountsValid(counts, quantityTotal) {
      return counts.keys().hasOnly(['excellent', 'good', 'fair', 'needs_repair', 'unusable'])
        && counts.keys().hasAll(['excellent', 'good', 'fair', 'needs_repair', 'unusable'])
        && isCount(counts.excellent)
        && isCount(counts.good)
        && isCount(counts.fair)
        && isCount(counts.needs_repair)
        && isCount(counts.unusable)
        && counts.excellent + counts.good + counts.fair + counts.needs_repair + counts.unusable
             <= quantityTotal;
    }

    // The seven buckets a serialized item keeps, and the one arithmetic fact
    // about them a rule can actually check.
    //
    // What it cannot check is whether the numbers match the units they claim to
    // count: Rules cannot query a collection, so an unknown set of sibling
    // documents cannot be tallied. Later phases keep them true by mutating a
    // unit and its parent inside one transaction. This is the part that is
    // enforceable, and it is enforced.
    //
    // The invariant is not the obvious one. `unusable_on_hand` is what makes it
    // hold: a unit on the shelf in unusable condition is active and present,
    // but nothing can count on it, so it is not available.
    function unitCountsValid(counts) {
      return counts.keys().hasOnly(['active_total', 'available', 'unusable_on_hand',
                                    'in_use', 'in_maintenance', 'lost', 'retired'])
        && counts.keys().hasAll(['active_total', 'available', 'unusable_on_hand',
                                 'in_use', 'in_maintenance', 'lost', 'retired'])
        && isCount(counts.active_total)
        && isCount(counts.available)
        && isCount(counts.unusable_on_hand)
        && isCount(counts.in_use)
        && isCount(counts.in_maintenance)
        && isCount(counts.lost)
        && isCount(counts.retired)
        && counts.active_total == counts.available + counts.unusable_on_hand
             + counts.in_use + counts.in_maintenance + counts.lost;
    }

    function trackingModeOf(data) {
      return 'tracking_mode' in data ? data.tracking_mode : 'bulk';
    }

    // A serialized item's quantities are a mirror of its units, so the fields
    // everything else already reads — production shortage, the dashboard, the
    // AI context — keep meaning what they meant, without any of those callers
    // learning about units.
    //
    // Condition counts are exact rather than bounded here: every unit carries
    // one condition, so an active unit is in exactly one bucket. A bulk item
    // keeps the looser rule, because there the counts are a person's partial
    // record of a quantity and an unclassified remainder is legitimate.
    function serializedMirrorsValid(data) {
      return 'unit_counts' in data
        && unitCountsValid(data.unit_counts)
        && data.quantity_total == data.unit_counts.active_total
        && data.quantity_available == data.unit_counts.available
        && data.condition_counts.excellent + data.condition_counts.good
             + data.condition_counts.fair + data.condition_counts.needs_repair
             + data.condition_counts.unusable
           == data.unit_counts.active_total;
    }

    function inventoryFieldsValid(itemId) {
      return hasExactly(
               ['item_id', 'organization_id', 'name', 'category', 'team_id', 'quantity_total',
                'quantity_available', 'condition_counts', 'location', 'created_by_uid',
                'created_at', 'updated_at'],
               ['tracking_mode', 'unit_counts', 'last_inspected_at', 'notes',
                'unit_cost_cents'])
        && trackingModeOf(request.resource.data) in ['bulk', 'serialized']
        // A bulk item has no units, so it has nothing to summarize. Written as
        // two guarded alternatives rather than a ternary: `&&` short-circuits
        // reliably here, so the mirror checks never look at a map a bulk item
        // does not carry.
        && ((trackingModeOf(request.resource.data) == 'serialized'
             && serializedMirrorsValid(request.resource.data))
            || (trackingModeOf(request.resource.data) == 'bulk'
                && !('unit_counts' in request.resource.data)))
        && request.resource.data.item_id == itemId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.category is string
        && isAllowedCategory(request.resource.data.category)
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.location.size() <= 120
        && isCount(request.resource.data.quantity_total)
        && isCount(request.resource.data.quantity_available)
        && request.resource.data.quantity_available <= request.resource.data.quantity_total
        && conditionCountsValid(request.resource.data.condition_counts,
                                request.resource.data.quantity_total)
        && (!('notes' in request.resource.data)
            || (request.resource.data.notes is string
                && request.resource.data.notes.size() <= 2000))
        && (!('last_inspected_at' in request.resource.data)
            || request.resource.data.last_inspected_at is timestamp)
        // Planning data: what one of these would cost to replace. Optional,
        // because most of an existing catalog has never been priced.
        && (!('unit_cost_cents' in request.resource.data)
            || isCostCents(request.resource.data.unit_cost_cents))
        && request.resource.data.updated_at == request.time
        && teamBelongsToOrganization(request.resource.data.organization_id,
                                     request.resource.data.team_id);
    }

    // The mirrors of a serialized item: the numbers counted from its units.
    //
    // A serialized item's team is a catalog default, not a claim on the
    // equipment. Scenic's clamp under a Lighting-owned item belongs to Scenic,
    // and recording that it broke means writing these numbers — so requiring
    // Lighting's team would lock the owner out of their own unit.
    //
    // The path is deliberately narrow. Only these fields may move, the item must
    // be serialized on both sides, and everything else about it stays behind the
    // ordinary team policy. What it costs is that any inventory editor in the
    // organization can adjust a serialized item's counts. Rules cannot count
    // documents, so they could never confirm the numbers match the units anyway;
    // what they still enforce is that whatever is written adds up.
    function isSerializedMirrorUpdate() {
      return trackingModeOf(resource.data) == 'serialized'
        && trackingModeOf(request.resource.data) == 'serialized'
        && changedOnly(['unit_counts', 'quantity_total', 'quantity_available',
                        'condition_counts', 'updated_at']);
    }

    function canUpdateSerializedMirrors(organizationId) {
      return isSignedIn() && (
        isAdminOf(organizationId)
        || (isActiveMemberOf(organizationId)
            && inventoryLevel(organizationId) == 'edit')
      );
    }

    match /inventory_items/{itemId} {

      // Organization-wide read for anyone with the module, Admin included.
      allow get, list: if canViewInventory(resource.data.organization_id);

      allow create: if inventoryFieldsValid(itemId)
        && canWriteInventoryForTeam(request.resource.data.organization_id,
                                    request.resource.data.team_id)
        && request.resource.data.created_by_uid == uid()
        && request.resource.data.created_at == request.time;

      allow update: if inventoryFieldsValid(itemId)
        // Identity, organization, and authorship never change.
        && request.resource.data.item_id == resource.data.item_id
        && request.resource.data.organization_id == resource.data.organization_id
        && request.resource.data.created_by_uid == resource.data.created_by_uid
        && request.resource.data.created_at == resource.data.created_at
        // Promotion to serialized is one way. Going back would strand the unit
        // documents and the history attached to them; a fresh item is the
        // honest alternative.
        && !(trackingModeOf(resource.data) == 'serialized'
             && trackingModeOf(request.resource.data) == 'bulk')
        // A ternary rather than an `or`: evaluating both arms costs more
        // expressions than one rule evaluation is allowed, and only one of them
        // can apply to a given write anyway.
        && (isSerializedMirrorUpdate()
            // The mirrors a unit operation moves, which any inventory editor may
            // write because the unit they own may sit under another crew's item.
            ? canUpdateSerializedMirrors(resource.data.organization_id)
            // Anything else about the item: editable as it stands, and editable
            // where it is going. Unchanged for bulk items and for metadata.
            // The second check runs only when the team is actually moving.
            // Evaluating it unconditionally costs more expressions than one
            // rule evaluation is allowed once the mirror path is in the chain.
            : (canWriteInventoryForTeam(resource.data.organization_id, resource.data.team_id)
               && (request.resource.data.team_id == resource.data.team_id
                   || canWriteInventoryForTeam(resource.data.organization_id,
                                               request.resource.data.team_id))));

      // No delete flow in the MVP. Maintenance history and, from Phase 5,
      // production requirements reference these items.
      allow delete: if false;
    }

    // ------------------------------------------------------- inventory_units

    // One document per physical object, for items tracked serially.
    //
    // A unit carries copies of its parent's organization, item, and team. That
    // is not convenience: it is what lets a write be authorized without reading
    // the parent, which keeps the access-call budget low enough for a later
    // checkout to move a unit, adjust its parent's counters, and record an event
    // in one transaction. `maintenance_records` carries a team snapshot for the
    // same reason. All three are immutable, so the copy cannot drift into
    // granting access the parent would not.

    function unitStatusValid(data) {
      return data.status in ['available', 'in_use', 'in_maintenance', 'lost', 'retired']
        && data.condition in ['excellent', 'good', 'fair', 'needs_repair', 'unusable']
        // A retirement reason belongs to a retired unit and to nothing else.
        && (data.status == 'retired'
            ? ('retirement_reason' in data
               && data.retirement_reason in
                    ['disposed', 'permanently_lost', 'donated', 'sold', 'other'])
            : !('retirement_reason' in data))
        // Borrowing details describe a unit that is out, and only that.
        && (data.status == 'in_use'
            ? 'using_team_id' in data
            : (!('using_team_id' in data)
               && !('using_member_uid' in data)
               && !('checked_out_at' in data)))
        // A member cannot be recorded without the team they were borrowing for.
        && (!('using_member_uid' in data) || 'using_team_id' in data);
    }

    // Who a unit may be lent to.
    //
    // For a member this is a real boundary, and it is free: the membership
    // document is already read to authorize the write at all, so holding them to
    // their own assigned teams is a second field of a document Rules have in
    // hand. Owning team and using team may still differ, which is the point —
    // Scenic's ladder in Lighting's hands is a thing that happens, and a member
    // on both crews can record it. What they cannot do is attribute equipment to
    // a crew they are not on.
    //
    // For an Admin, Rules check the shape and stop there. Reading the team
    // document would be referential integrity rather than authorization: an
    // Admin may already write any inventory in their organization, so a bad
    // `using_team_id` from an Admin is a data-quality problem, not an escalation.
    // It is also unaffordable. The read is charged per distinct team, and
    // `tests/rules/inventory-unit-transactions.test.ts` measures the ceiling for
    // one batch at seven — a department with eight crews would see a legitimate
    // conversion fail with a permission error it could do nothing about. The
    // service checks the team against the organization's real teams before the
    // transaction opens.
    function usingTeamAllowed(organizationId, data) {
      return !('using_team_id' in data)
        || isAdminOf(organizationId)
        || data.using_team_id in membershipData(organizationId).team_ids;
    }

    function unitFieldsValid(unitId) {
      return hasExactly(
               ['unit_id', 'organization_id', 'inventory_item_id', 'team_id', 'asset_code',
                'condition', 'status', 'storage_location', 'created_by_uid', 'created_at',
                'updated_at'],
               ['retirement_reason', 'using_team_id', 'using_member_uid', 'checked_out_at',
                'last_known_location', 'last_inspected_at', 'notes',
                'last_lifecycle_event_id', 'current_maintenance_record_id',
                'maintenance_record_ids', 'planned_maintenance_record_id'])
        && request.resource.data.unit_id == unitId
        && request.resource.data.asset_code is string
        && request.resource.data.asset_code.size() > 0
        && request.resource.data.asset_code.size() <= 60
        && request.resource.data.storage_location is string
        && request.resource.data.storage_location.size() > 0
        && request.resource.data.storage_location.size() <= 120
        && unitStatusValid(request.resource.data)
        // Non-empty, not merely present: an `in_use` unit naming an empty team
        // would satisfy the status check below while recording nothing about
        // who actually has the equipment.
        && (!('using_team_id' in request.resource.data)
            || (request.resource.data.using_team_id is string
                && request.resource.data.using_team_id.size() > 0))
        && (!('using_member_uid' in request.resource.data)
            || (request.resource.data.using_member_uid is string
                && request.resource.data.using_member_uid.size() > 0))
        && (!('checked_out_at' in request.resource.data)
            || request.resource.data.checked_out_at is timestamp)
        && (!('last_known_location' in request.resource.data)
            || (request.resource.data.last_known_location is string
                && request.resource.data.last_known_location.size() <= 120))
        && (!('last_inspected_at' in request.resource.data)
            || request.resource.data.last_inspected_at is timestamp)
        && (!('notes' in request.resource.data)
            || (request.resource.data.notes is string
                && request.resource.data.notes.size() <= 2000))
        && (!('last_lifecycle_event_id' in request.resource.data)
            || (request.resource.data.last_lifecycle_event_id is string
                && request.resource.data.last_lifecycle_event_id.size() > 0))
        // A unit away for repair names the record that took it, and a unit that
        // is not away names nothing. The pointer is current state, not history:
        // it answers "where is this right now" without a query.
        && (request.resource.data.status == 'in_maintenance'
            ? ('current_maintenance_record_id' in request.resource.data
               && request.resource.data.current_maintenance_record_id is string
               && request.resource.data.current_maintenance_record_id.size() > 0)
            : !('current_maintenance_record_id' in request.resource.data))
        && (!('maintenance_record_ids' in request.resource.data)
            || (request.resource.data.maintenance_record_ids is list
                && request.resource.data.maintenance_record_ids.size() <= 200
                && isDistinctList(request.resource.data.maintenance_record_ids)))
        && (!('planned_maintenance_record_id' in request.resource.data)
            || (request.resource.data.planned_maintenance_record_id is string
                && request.resource.data.planned_maintenance_record_id.size() > 0))
        && request.resource.data.updated_at == request.time
        && request.resource.data.team_id is string
        && request.resource.data.team_id.size() > 0;
    }

    // The lifecycle, as the domain defines it. Rules enforce the same shape the
    // application does, because the application is not the security boundary:
    // a direct write must not be able to bring a retired unit back or move one
    // out of maintenance without the repair workflow.
    function unitTransitionAllowed(from, to) {
      return (from == 'available' && to in ['in_use', 'in_maintenance', 'lost', 'retired'])
        || (from == 'in_use' && to in ['available', 'in_maintenance', 'lost', 'retired'])
        || (from == 'in_maintenance' && to in ['available', 'lost', 'retired'])
        || (from == 'lost' && to in ['available', 'retired']);
    }

    function maintenancePath(recordId) {
      return /databases/$(database)/documents/maintenance_records/$(recordId);
    }

    function eventPath(eventId) {
      return /databases/$(database)/documents/asset_events/$(eventId);
    }

    /**
     * A status change has to carry its history.
     *
     * Rules cannot search a collection, so they cannot ask "is there an event
     * for this move". The unit names one instead, and this checks that the
     * named event is real, is about this unit, and describes this exact move.
     * Combined with the event rule requiring the unit to point back at it, one
     * cannot exist without the other.
     */
    /**
     * A maintenance move, proven against one event shared by the whole batch.
     *
     * The per-unit form below costs one document read per unit, because each
     * unit reads a different event. Sending ten clamps for repair therefore
     * exhausted the twenty-call budget at six — measured, not guessed. Here
     * every unit in the batch reads the *same* event, which Rules charge once
     * however many units name it, so the cost stops growing with the batch.
     *
     * What each unit still proves for itself: the event exists, it lists this
     * unit, it describes this exact move, and it names the same maintenance
     * record the unit now points at. So a unit cannot slip into maintenance on
     * somebody else's event, nor name a record the event does not agree with.
     */
    function unitMaintenanceEventValid() {
      return 'last_lifecycle_event_id' in request.resource.data
        && request.resource.data.last_lifecycle_event_id
             != resource.data.get('last_lifecycle_event_id', '')
        && existsAfter(eventPath(request.resource.data.last_lifecycle_event_id))
        && getAfter(eventPath(request.resource.data.last_lifecycle_event_id)).data
             .get('inventory_unit_ids', []).hasAny([request.resource.data.unit_id])
        && getAfter(eventPath(request.resource.data.last_lifecycle_event_id)).data
             .from_status == resource.data.status
        && getAfter(eventPath(request.resource.data.last_lifecycle_event_id)).data
             .to_status == request.resource.data.status
        // Going in, the unit and the event must name the same record; coming
        // back, the event names the record the unit is leaving.
        && getAfter(eventPath(request.resource.data.last_lifecycle_event_id)).data
             .get('maintenance_record_id', '')
             == (request.resource.data.status == 'in_maintenance'
                 ? request.resource.data.current_maintenance_record_id
                 : resource.data.get('current_maintenance_record_id', ''));
    }

    function isMaintenanceMove(from, to) {
      return (from == 'available' && to == 'in_maintenance')
        || (from == 'in_maintenance' && to == 'available');
    }

    function unitLifecycleEventValid() {
      return 'last_lifecycle_event_id' in request.resource.data
        && request.resource.data.last_lifecycle_event_id
             != resource.data.get('last_lifecycle_event_id', '')
        && existsAfter(eventPath(request.resource.data.last_lifecycle_event_id))
        && getAfter(eventPath(request.resource.data.last_lifecycle_event_id)).data
             .inventory_unit_id == request.resource.data.unit_id
        && getAfter(eventPath(request.resource.data.last_lifecycle_event_id)).data
             .from_status == resource.data.status
        && getAfter(eventPath(request.resource.data.last_lifecycle_event_id)).data
             .to_status == request.resource.data.status;
    }

    // The unit and its parent must belong to the same organization. Checked once,
    // at creation; `organization_id` and `inventory_item_id` are immutable
    // afterwards, so re-reading the parent on every edit would buy nothing.
    //
    // The parent's team is deliberately not checked. Units of one item may be
    // owned by different crews — Lighting's clamps and Scenic's clamps are the
    // same catalog entry and different property — so the parent's team is a
    // default at creation rather than a claim about every unit.
    function unitParentAgrees(data) {
      return exists(itemPath(data.inventory_item_id))
        && get(itemPath(data.inventory_item_id)).data.organization_id == data.organization_id;
    }

    match /inventory_units/{unitId} {

      // Organization-wide, like the parent item. Reading what the organization
      // owns is not bounded by team; editing it is.
      allow get, list: if canViewInventory(resource.data.organization_id);

      allow create: if unitFieldsValid(unitId)
        && canWriteInventoryForTeam(request.resource.data.organization_id,
                                    request.resource.data.team_id)
        && usingTeamAllowed(request.resource.data.organization_id, request.resource.data)
        && unitParentAgrees(request.resource.data)
        && request.resource.data.created_by_uid == uid()
        && request.resource.data.created_at == request.time;

      allow update: if unitFieldsValid(unitId)
        // Identity, the parent link, and authorship are fixed. The owning team
        // is not: a unit can change hands between crews.
        && request.resource.data.unit_id == resource.data.unit_id
        && request.resource.data.organization_id == resource.data.organization_id
        && request.resource.data.inventory_item_id == resource.data.inventory_item_id
        && request.resource.data.created_by_uid == resource.data.created_by_uid
        && request.resource.data.created_at == resource.data.created_at
        // Editable as it stands, and editable where it is going — the same test
        // an item's team move gets, and for the same reason. The owning team is
        // what authorizes writes to this unit, so handing it to another crew is
        // a change of security boundary rather than an ordinary field edit.
        && canWriteInventoryForTeam(resource.data.organization_id, resource.data.team_id)
        // Only when the unit is actually changing hands. Evaluating this on
        // every write costs more expressions than one evaluation is allowed
        // once the maintenance checks are in the chain — the same limit that
        // bit the item rule in decision 73a.
        && (request.resource.data.team_id == resource.data.team_id
            || canWriteInventoryForTeam(resource.data.organization_id,
                                        request.resource.data.team_id))
        && usingTeamAllowed(resource.data.organization_id, request.resource.data)
        && plannedRefValid()
        // Editing what a unit *is* — its code, condition, location, notes,
        // owning team — leaves the status alone and needs no history. Changing
        // where it is in its life is a different kind of write.
        && (request.resource.data.status == resource.data.status
            ? (request.resource.data.get('last_lifecycle_event_id', '')
                 == resource.data.get('last_lifecycle_event_id', '')
               && maintenanceHistoryUnchanged())
            : (unitTransitionAllowed(resource.data.status, request.resource.data.status)
               && (isMaintenanceMove(resource.data.status, request.resource.data.status)
                   ? (unitMaintenanceEventValid()
                      // Going out adds the visit; coming back leaves the record
                      // of it exactly where it is.
                      && (request.resource.data.status == 'in_maintenance'
                          ? maintenanceHistoryAppended()
                          : maintenanceHistoryUnchanged()))
                   : (unitLifecycleEventValid() && maintenanceHistoryUnchanged()))));

      // Equipment leaves the inventory by being retired, which keeps its
      // history. Deleting it would destroy exactly the record this collection
      // exists to hold. See decision 7 of the Phase 11 analysis.
      allow delete: if false;
    }

    // ---------------------------------------------------- maintenance_records

    // Same two axes as inventory: reading is organization-wide for anyone with
    // the module, editing is bounded by team. The team here is the snapshot
    // stored on the record, not the linked item's current team, so the crew that
    // filed a repair keeps control of it after the item moves.

    function maintenanceLevel(organizationId) {
      return membershipData(organizationId).permissions.maintenance;
    }

    function canViewMaintenance(organizationId) {
      return isSignedIn() && (
        isAdminOf(organizationId)
        || (isActiveMemberOf(organizationId)
            && maintenanceLevel(organizationId) in ['view', 'edit'])
      );
    }

    function canWriteMaintenanceForTeam(organizationId, teamId) {
      return isSignedIn() && (
        isAdminOf(organizationId)
        || (isActiveMemberOf(organizationId)
            && maintenanceLevel(organizationId) == 'edit'
            && teamId in membershipData(organizationId).team_ids)
      );
    }

    function unitPath(unitId) {
      return /databases/$(database)/documents/inventory_units/$(unitId);
    }

    function itemPath(itemId) {
      return /databases/$(database)/documents/inventory_items/$(itemId);
    }

    // The record must point at a real item in the same organization, and its
    // team must be the copy the service made. Without this a crafted team_id
    // could widen who may edit the record afterwards.
    function linkedItemAgrees(organizationId, itemId, teamId) {
      return exists(itemPath(itemId))
        && get(itemPath(itemId)).data.organization_id == organizationId
        && get(itemPath(itemId)).data.team_id == teamId;
    }

    function quantityFitsItem(itemId, quantitySent) {
      return quantitySent <= get(itemPath(itemId)).data.quantity_total;
    }

    // Only the per-record rule is enforceable here. The sum across an item's
    // active records cannot be: Rules have no query capability, so an unknown
    // set of sibling documents cannot be aggregated. That total is a warning in
    // the interface, never a boundary. See decision 45.
    function maintenanceTrackingModeOf(data) {
      return 'tracking_mode' in data ? data.tracking_mode : 'bulk';
    }

    /**
     * How many units the parent says entered or left maintenance in this write.
     *
     * Every unit moving into `in_maintenance` raises that bucket by exactly one,
     * and every unit leaving lowers it by one, whatever condition it is in. So
     * the parent's own arithmetic counts the batch — and the parent is written
     * in the same transaction by rules that already insist its numbers add up.
     *
     * This is what stops a record claiming fifty units while one moves. Rules
     * cannot count how many unit documents a transaction touched, but they can
     * read one number that only moves when units do.
     */
    function maintenanceBucketDelta(itemId) {
      return getAfter(itemPath(itemId)).data.unit_counts.in_maintenance
        - get(itemPath(itemId)).data.unit_counts.in_maintenance;
    }

    /**
     * Every repair this unit has been through, and how the list may change.
     *
     * Append-only, one entry per visit to the shop, added at the moment the
     * unit leaves. Nothing else may touch it: a metadata edit carries it
     * through, coming back leaves it alone, and no write may drop or rewrite
     * what is already there. This is what lets a unit page answer "has this
     * clamp been repaired before" from the unit itself, rather than by
     * searching a collection for events that claim it.
     */
    function historyOf(data) {
      return 'maintenance_record_ids' in data ? data.maintenance_record_ids : [];
    }

    function maintenanceHistoryUnchanged() {
      return historyOf(request.resource.data) == historyOf(resource.data);
    }

    function maintenanceHistoryAppended() {
      // Spelled out as size and membership rather than list concatenation:
      // `concat` on the result of a defaulted `get` does not evaluate here, and
      // these three conditions say the same thing. Exactly one entry longer,
      // everything that was there is still there, and the new entry is this
      // repair — which `isDistinctList` above then keeps from repeating.
      return 'maintenance_record_ids' in request.resource.data
        && request.resource.data.maintenance_record_ids.size()
             == historyOf(resource.data).size() + 1
        && request.resource.data.maintenance_record_ids
             .hasAll(historyOf(resource.data))
        && request.resource.data.maintenance_record_ids
             .hasAny([request.resource.data.current_maintenance_record_id])
        && !historyOf(resource.data)
              .hasAny([request.resource.data.current_maintenance_record_id]);
    }

    function plannedRefOf(data) {
      return 'planned_maintenance_record_id' in data
        ? data.planned_maintenance_record_id : '';
    }

    /**
     * Whether a unit's planned-repair pointer may take the value it is taking.
     *
     * Unchanged is always allowed, and that is the ordinary case: a plan
     * survives the unit being taken out, checked in, or lost, because a plan is
     * an intention about the future and none of those change it.
     *
     * Changing it requires the plan itself to be part of the same write, and to
     * agree. Taking a pointer means the named plan exists, is still planned, and
     * lists this unit. Dropping one means that plan has moved on — started,
     * cancelled, or edited to leave this unit out.
     *
     * A unit may hold only one plan at a time. Taking a pointer while another is
     * already set is refused, which is the simplest way to stop the same
     * microphone being planned into two repairs at once.
     */
    function plannedRefValid() {
      return plannedRefOf(request.resource.data) == plannedRefOf(resource.data)
        || (plannedRefOf(request.resource.data) != ''
            ? (plannedRefOf(resource.data) == ''
               && existsAfter(maintenancePath(plannedRefOf(request.resource.data)))
               && getAfter(maintenancePath(plannedRefOf(request.resource.data))).data.status
                    == 'planned'
               && getAfter(maintenancePath(plannedRefOf(request.resource.data))).data
                    .get('unit_ids', []).hasAny([request.resource.data.unit_id]))
            : (existsAfter(maintenancePath(plannedRefOf(resource.data)))
               && (getAfter(maintenancePath(plannedRefOf(resource.data))).data.status != 'planned'
                   || !getAfter(maintenancePath(plannedRefOf(resource.data))).data
                         .get('unit_ids', []).hasAny([resource.data.unit_id]))));
    }

    /**
     * The moves that bring equipment back: a repair finishing, or being called
     * off after it left. Every other step — sent to in_service, in_service to
     * ready — is paperwork about equipment that has not moved.
     */
    function isMaintenanceClosing(from, to) {
      return from in ['sent', 'in_service', 'ready']
        && to in ['returned', 'cancelled'];
    }

    /**
     * What the parent's maintenance count must do for a given repair move.
     *
     * Starting takes the equipment; ending brings it back; everything else —
     * editing a plan, stepping a live repair through the shop's stages,
     * cancelling something that never left — moves nothing at all.
     */
    function serializedMaintenanceDelta(before, after) {
      return before.status == 'planned'
        ? (after.status in ['sent', 'in_service', 'ready']
           // The moment a plan becomes real, and the only moment its equipment
           // moves. The new list is what leaves, since a plan's list is still
           // editable right up until this write.
           ? maintenanceBucketDelta(before.item_id) == after.unit_ids.size()
           // Editing the plan, or calling it off before it ever started.
           : maintenanceBucketDelta(before.item_id) == 0)
        : (isMaintenanceClosing(before.status, after.status)
           // Phase 11D has no partial return: the whole list comes home.
           ? maintenanceBucketDelta(before.item_id) == -before.unit_ids.size()
           : maintenanceBucketDelta(before.item_id) == 0);
    }

    /** A list with no repeats, so a count cannot be padded with one id. */
    function isDistinctList(values) {
      return values.toSet().size() == values.size();
    }

    function maintenanceFieldsValid(maintenanceId) {
      return hasExactly(
               ['maintenance_id', 'organization_id', 'item_id', 'team_id', 'quantity_sent',
                'issue_description', 'status', 'created_by_uid', 'created_at', 'updated_at'],
               ['sent_at', 'return_method', 'expected_return_at', 'returned_at',
                'service_provider_name', 'service_provider_phone', 'service_provider_email',
                'cost', 'repair_notes', 'tracking_mode', 'unit_ids'])
        && request.resource.data.maintenance_id == maintenanceId
        && request.resource.data.quantity_sent is int
        && request.resource.data.quantity_sent > 0
        // A serialized repair names the equipment it took. The quantity stays,
        // mirroring the list, so everything that already reads it — the
        // dashboard, the in-service sum — keeps working untouched.
        && (maintenanceTrackingModeOf(request.resource.data) == 'serialized'
            ? (request.resource.data.unit_ids is list
               && request.resource.data.unit_ids.size() > 0
               && request.resource.data.unit_ids.size() <= 200
               && isDistinctList(request.resource.data.unit_ids)
               // `planned` is allowed here and means something different from
               // every other status: an intention, with no physical effect. The
               // equipment is not reserved, not taken out of availability, and
               // free to be used until the repair actually starts. What each
               // status must do to the parent's counts is settled below.
               && request.resource.data.quantity_sent
                    == request.resource.data.unit_ids.size())
            : !('unit_ids' in request.resource.data))
        && request.resource.data.issue_description is string
        && request.resource.data.issue_description.size() > 0
        && request.resource.data.issue_description.size() <= 1000
        && request.resource.data.status in
             ['planned', 'sent', 'in_service', 'ready', 'returned', 'cancelled']
        && (!('return_method' in request.resource.data)
            || request.resource.data.return_method in ['pickup', 'delivery', 'other'])
        && (!('sent_at' in request.resource.data)
            || request.resource.data.sent_at is timestamp)
        && (!('expected_return_at' in request.resource.data)
            || request.resource.data.expected_return_at is timestamp)
        && (!('returned_at' in request.resource.data)
            || request.resource.data.returned_at is timestamp)
        && (!('service_provider_name' in request.resource.data)
            || (request.resource.data.service_provider_name is string
                && request.resource.data.service_provider_name.size() <= 120))
        && (!('service_provider_phone' in request.resource.data)
            || (request.resource.data.service_provider_phone is string
                && request.resource.data.service_provider_phone.size() <= 120))
        && (!('service_provider_email' in request.resource.data)
            || (request.resource.data.service_provider_email is string
                && request.resource.data.service_provider_email.size() <= 120))
        && (!('cost' in request.resource.data)
            || (request.resource.data.cost is number && request.resource.data.cost >= 0))
        && (!('repair_notes' in request.resource.data)
            || (request.resource.data.repair_notes is string
                && request.resource.data.repair_notes.size() <= 2000))
        && request.resource.data.updated_at == request.time;
    }

    match /maintenance_records/{maintenanceId} {

      allow get, list: if canViewMaintenance(resource.data.organization_id);

      allow create: if maintenanceFieldsValid(maintenanceId)
        && canWriteMaintenanceForTeam(request.resource.data.organization_id,
                                      request.resource.data.team_id)
        && linkedItemAgrees(request.resource.data.organization_id,
                            request.resource.data.item_id,
                            request.resource.data.team_id)
        && quantityFitsItem(request.resource.data.item_id,
                            request.resource.data.quantity_sent)
        // A serialized repair takes the equipment with it. The parent has to
        // show exactly that many units entering maintenance in this same write,
        // which is what a record cannot fake: claiming fifty while moving one
        // leaves a delta of one against a list of fifty.
        && (maintenanceTrackingModeOf(request.resource.data) == 'serialized'
            ? (request.resource.data.status == 'planned'
               // A plan moves nothing. The equipment stays exactly where it is,
               // which is the whole point: planning a repair for next week must
               // not stop anyone using the microphone this week.
               ? maintenanceBucketDelta(request.resource.data.item_id) == 0
               // Recording a repair is not the same as starting one. Equipment
               // sent on Monday may not be entered until Wednesday, by which
               // time it is already being worked on — so any stage where the
               // equipment is away may be the one it is first written down at.
               // What it may not be is finished.
               : (request.resource.data.status in ['sent', 'in_service', 'ready']
                  && maintenanceBucketDelta(request.resource.data.item_id)
                       == request.resource.data.unit_ids.size()))
            : true)
        && request.resource.data.created_by_uid == uid()
        && request.resource.data.created_at == request.time;

      allow update: if maintenanceFieldsValid(maintenanceId)
        // Identity, the item link, the team snapshot, and authorship never
        // change. The snapshot in particular records who sent the equipment out.
        && request.resource.data.maintenance_id == resource.data.maintenance_id
        && request.resource.data.organization_id == resource.data.organization_id
        && request.resource.data.item_id == resource.data.item_id
        && request.resource.data.team_id == resource.data.team_id
        && request.resource.data.created_by_uid == resource.data.created_by_uid
        && request.resource.data.created_at == resource.data.created_at
        // Edit scope follows the stored snapshot.
        && canWriteMaintenanceForTeam(resource.data.organization_id, resource.data.team_id)
        // Only a changed quantity is re-checked, so an item whose total was
        // reduced later does not freeze edits to unrelated fields.
        && (request.resource.data.quantity_sent == resource.data.quantity_sent
            || quantityFitsItem(resource.data.item_id, request.resource.data.quantity_sent))
        // What equipment a repair took is settled when it leaves. Rewriting the
        // list afterwards would rewrite what happened, and the units' own
        // history would no longer agree with it. Send a different set by
        // cancelling this record and creating another.
        && maintenanceTrackingModeOf(request.resource.data)
             == maintenanceTrackingModeOf(resource.data)
        // What equipment a repair took is settled the moment it takes it. While
        // a repair is still only planned, nothing has been taken, so the list is
        // still a decision rather than a record.
        && (resource.data.status == 'planned'
            || request.resource.data.get('unit_ids', []) == resource.data.get('unit_ids', []))
        && (maintenanceTrackingModeOf(resource.data) == 'serialized'
            ? serializedMaintenanceDelta(resource.data, request.resource.data)
            : true);

      // Repair history is permanent. Documents say it should not be deleted
      // casually, and nothing in the MVP authorizes deleting it at all.
      allow delete: if false;
    }

    // ------------------------------------------------- productions and friends

    function productionsLevel(organizationId) {
      return membershipData(organizationId).permissions.productions;
    }

    function canViewProductions(organizationId) {
      return isSignedIn() && (
        isAdminOf(organizationId)
        || (isActiveMemberOf(organizationId)
            && productionsLevel(organizationId) in ['view', 'edit'])
      );
    }

    // Productions themselves are organization-level: the module permission
    // alone decides, with no team check.
    function canEditProductions(organizationId) {
      return isSignedIn() && (
        isAdminOf(organizationId)
        || (isActiveMemberOf(organizationId)
            && productionsLevel(organizationId) == 'edit')
      );
    }

    // Requirements and action items are team-scoped for editing.
    function canEditProductionsForTeam(organizationId, teamId) {
      return isSignedIn() && (
        isAdminOf(organizationId)
        || (isActiveMemberOf(organizationId)
            && productionsLevel(organizationId) == 'edit'
            && teamId in membershipData(organizationId).team_ids)
      );
    }

    function productionPath(productionId) {
      return /databases/$(database)/documents/productions/$(productionId);
    }

    function requirementPath(requirementId) {
      return /databases/$(database)/documents/production_requirements/$(requirementId);
    }

    match /productions/{productionId} {

      allow get, list: if canViewProductions(resource.data.organization_id);

      allow create: if canEditProductions(request.resource.data.organization_id)
        && productionFieldsValid(productionId)
        && request.resource.data.created_by_uid == uid()
        && request.resource.data.created_at == request.time;

      allow update: if canEditProductions(resource.data.organization_id)
        && productionFieldsValid(productionId)
        && request.resource.data.production_id == resource.data.production_id
        && request.resource.data.organization_id == resource.data.organization_id
        && request.resource.data.created_by_uid == resource.data.created_by_uid
        && request.resource.data.created_at == resource.data.created_at;

      // Completed productions are archived by status, never removed.
      allow delete: if false;
    }

    function productionFieldsValid(productionId) {
      return hasExactly(
               ['production_id', 'organization_id', 'title', 'status',
                'created_by_uid', 'created_at', 'updated_at'],
               ['description', 'notes', 'start_date', 'end_date'])
        && request.resource.data.production_id == productionId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.status in ['planning', 'active', 'completed']
        && (!('description' in request.resource.data)
            || (request.resource.data.description is string
                && request.resource.data.description.size() <= 2000))
        && (!('notes' in request.resource.data)
            || (request.resource.data.notes is string
                && request.resource.data.notes.size() <= 2000))
        && (!('start_date' in request.resource.data)
            || request.resource.data.start_date is timestamp)
        && (!('end_date' in request.resource.data)
            || request.resource.data.end_date is timestamp)
        && request.resource.data.updated_at == request.time;
    }

    match /production_requirements/{requirementId} {

      allow get, list: if canViewProductions(resource.data.organization_id);

      allow create: if requirementFieldsValid(requirementId)
        && canEditProductionsForTeam(request.resource.data.organization_id,
                                     request.resource.data.team_id)
        && requirementLinksValid(request.resource.data)
        && request.resource.data.created_by_uid == uid()
        && request.resource.data.created_at == request.time;

      allow update: if requirementFieldsValid(requirementId)
        && request.resource.data.requirement_id == resource.data.requirement_id
        && request.resource.data.organization_id == resource.data.organization_id
        && request.resource.data.production_id == resource.data.production_id
        && request.resource.data.created_by_uid == resource.data.created_by_uid
        && request.resource.data.created_at == resource.data.created_at
        // Editable as it stands, and editable where it is going.
        && canEditProductionsForTeam(resource.data.organization_id, resource.data.team_id)
        && canEditProductionsForTeam(resource.data.organization_id,
                                     request.resource.data.team_id)
        && requirementLinksValid(request.resource.data);

      allow delete: if false;
    }

    function requirementFieldsValid(requirementId) {
      return hasExactly(
               ['requirement_id', 'organization_id', 'production_id', 'item_name',
                'required_qty', 'team_id', 'source', 'created_by_uid', 'created_at',
                'updated_at'],
               ['inventory_item_id', 'notes'])
        && request.resource.data.requirement_id == requirementId
        && request.resource.data.item_name is string
        && request.resource.data.item_name.size() > 0
        && request.resource.data.item_name.size() <= 120
        && request.resource.data.required_qty is int
        && request.resource.data.required_qty > 0
        && request.resource.data.source in ['manual', 'ai_approved']
        && (!('notes' in request.resource.data)
            || (request.resource.data.notes is string
                && request.resource.data.notes.size() <= 2000))
        && request.resource.data.updated_at == request.time;
    }

    // The production must exist in the same organization. A matched inventory
    // item must too — but its team is deliberately unconstrained: a sound
    // requirement matching a lighting item is ordinary theater practice.
    function requirementLinksValid(data) {
      return exists(productionPath(data.production_id))
        && get(productionPath(data.production_id)).data.organization_id == data.organization_id
        && (!('inventory_item_id' in data)
            || (exists(itemPath(data.inventory_item_id))
                && get(itemPath(data.inventory_item_id)).data.organization_id
                     == data.organization_id));
    }

    match /action_items/{requirementId} {

      allow get, list: if canViewProductions(resource.data.organization_id);

      // Creation carries two conditions beyond permission, and both are
      // checkable here because the requirement and its item are reachable by
      // known path: the requirement must be matched, and it must actually be
      // short. An unmatched requirement has no shortage to act on, and a
      // satisfied one needs no work.
      allow create: if actionFieldsValid(requirementId)
        && canEditProductionsForTeam(request.resource.data.organization_id,
                                     request.resource.data.team_id)
        && actionMatchesRequirement(requirementId, request.resource.data)
        && requirementIsShort(requirementId)
        && request.resource.data.created_by_uid == uid()
        && request.resource.data.created_at == request.time;

      // Update deliberately does not re-check the shortage. Once inventory
      // arrives the shortage clears, and marking the work done has to stay
      // possible — the documents say to close such an item, never delete it.
      allow update: if actionFieldsValid(requirementId)
        && request.resource.data.action_item_id == resource.data.action_item_id
        && request.resource.data.organization_id == resource.data.organization_id
        && request.resource.data.production_id == resource.data.production_id
        && request.resource.data.requirement_id == resource.data.requirement_id
        && request.resource.data.team_id == resource.data.team_id
        && request.resource.data.created_by_uid == resource.data.created_by_uid
        && request.resource.data.created_at == resource.data.created_at
        && canEditProductionsForTeam(resource.data.organization_id, resource.data.team_id);

      // Work history. If a shortage clears, the item is closed, not removed.
      allow delete: if false;
    }

    function actionFieldsValid(requirementId) {
      return hasExactly(
               ['action_item_id', 'organization_id', 'production_id', 'requirement_id',
                'item_name', 'action_type', 'quantity', 'team_id', 'status',
                'created_by_uid', 'created_at', 'updated_at'],
               ['assignee_uid', 'due_date', 'notes', 'estimated_unit_cost_cents'])
        // The document ID is the requirement ID. That is what makes a second
        // action for the same requirement impossible.
        && request.resource.data.action_item_id == requirementId
        && request.resource.data.requirement_id == requirementId
        && request.resource.data.item_name is string
        && request.resource.data.item_name.size() > 0
        && request.resource.data.item_name.size() <= 120
        && request.resource.data.action_type in ['buy', 'rent', 'build', 'repair']
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.status in ['todo', 'in_progress', 'done', 'cancelled']
        && (!('notes' in request.resource.data)
            || (request.resource.data.notes is string
                && request.resource.data.notes.size() <= 2000))
        && (!('due_date' in request.resource.data)
            || request.resource.data.due_date is timestamp)
        // An estimate per unit. The line total is quantity times this and is
        // never stored, so there is no second number here to drift out of step.
        && (!('estimated_unit_cost_cents' in request.resource.data)
            || isCostCents(request.resource.data.estimated_unit_cost_cents))
        && request.resource.data.updated_at == request.time;
    }

    // The action inherits the requirement's organization, production, and team.
    // Without the team check an action could be filed under a crew that does not
    // own the requirement it resolves.
    function actionMatchesRequirement(requirementId, data) {
      return exists(requirementPath(requirementId))
        && get(requirementPath(requirementId)).data.organization_id == data.organization_id
        && get(requirementPath(requirementId)).data.production_id == data.production_id
        && get(requirementPath(requirementId)).data.team_id == data.team_id;
    }

    function requirementIsShort(requirementId) {
      return 'inventory_item_id' in get(requirementPath(requirementId)).data
        && exists(itemPath(get(requirementPath(requirementId)).data.inventory_item_id))
        && get(requirementPath(requirementId)).data.required_qty
             > get(itemPath(get(requirementPath(requirementId)).data.inventory_item_id))
                 .data.quantity_available;
    }

    // -------------------------------------------------------- calendar_events

    // Calendar is organization-level. Team scope does not apply: a member with
    // calendar edit may create and change any event, whatever teams it names.
    // `team_ids` is display metadata and is never read as a boundary here.

    function calendarLevel(organizationId) {
      return membershipData(organizationId).permissions.calendar;
    }

    function canViewCalendar(organizationId) {
      return isSignedIn() && (
        isAdminOf(organizationId)
        || (isActiveMemberOf(organizationId)
            && calendarLevel(organizationId) in ['view', 'edit'])
      );
    }

    function canEditCalendar(organizationId) {
      return isSignedIn() && (
        isAdminOf(organizationId)
        || (isActiveMemberOf(organizationId)
            && calendarLevel(organizationId) == 'edit')
      );
    }

    function isClockTime(value) {
      return value is string && value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    // Shape only. Whether each entry names a real team is deliberately not
    // checked: Rules can get() a known path, not iterate a list of unknown
    // length, and a partial check would read as integrity while guaranteeing
    // nothing. team_ids is not security-sensitive. See decision 49.
    function teamIdsShapeValid(data) {
      return data.team_ids is list
        && data.team_ids.size() <= 30
        && (data.visibility == 'all_teams'
              ? data.team_ids.size() == 0
              : data.team_ids.size() > 0);
    }

    // Linked records are single documents at known paths, so these are checked.
    function calendarLinksValid(data) {
      return (!('production_id' in data)
              || (exists(productionPath(data.production_id))
                  && get(productionPath(data.production_id)).data.organization_id
                       == data.organization_id))
        && (!('maintenance_id' in data)
            || (exists(/databases/$(database)/documents/maintenance_records/$(data.maintenance_id))
                && get(/databases/$(database)/documents/maintenance_records/$(data.maintenance_id))
                     .data.organization_id == data.organization_id));
    }

    function calendarFieldsValid(eventId) {
      return hasExactly(
               ['event_id', 'organization_id', 'title', 'event_type', 'event_date',
                'visibility', 'team_ids', 'created_by_uid', 'created_at', 'updated_at'],
               ['start_time', 'end_time', 'production_id', 'maintenance_id', 'notes'])
        && request.resource.data.event_id == eventId
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.event_type is string
        && request.resource.data.event_type.size() > 0
        && request.resource.data.event_type.size() <= 60
        && request.resource.data.event_date is timestamp
        && request.resource.data.visibility in ['all_teams', 'teams']
        && teamIdsShapeValid(request.resource.data)
        // No start time means an all-day event. An end time needs a start time
        // and cannot precede it; both are 'HH:mm', so a string compare orders
        // them correctly.
        && (!('start_time' in request.resource.data)
            || isClockTime(request.resource.data.start_time))
        && (!('end_time' in request.resource.data)
            || ('start_time' in request.resource.data
                && isClockTime(request.resource.data.end_time)
                && request.resource.data.end_time >= request.resource.data.start_time))
        && (!('notes' in request.resource.data)
            || (request.resource.data.notes is string
                && request.resource.data.notes.size() <= 2000))
        && calendarLinksValid(request.resource.data)
        && request.resource.data.updated_at == request.time;
    }

    match /calendar_events/{eventId} {

      allow get, list: if canViewCalendar(resource.data.organization_id);

      allow create: if canEditCalendar(request.resource.data.organization_id)
        && calendarFieldsValid(eventId)
        && request.resource.data.created_by_uid == uid()
        && request.resource.data.created_at == request.time;

      allow update: if canEditCalendar(resource.data.organization_id)
        && calendarFieldsValid(eventId)
        && request.resource.data.event_id == resource.data.event_id
        && request.resource.data.organization_id == resource.data.organization_id
        && request.resource.data.created_by_uid == resource.data.created_by_uid
        && request.resource.data.created_at == resource.data.created_at;

      // The only collection in the MVP where deletion is allowed. A cancelled
      // rehearsal is not history worth keeping the way a repair record is, and
      // IA section 9.2 states this directly.
      allow delete: if canEditCalendar(resource.data.organization_id);
    }


    // ----------------------------------------------------------- asset_events

    // What happened to a piece of equipment. Append-only: an event that could be
    // edited or deleted is not a history, and the value of this collection is
    // that it answers "who had this when it went missing" after the unit
    // document has stopped saying so.
    //
    // Reading follows the inventory module, like everything else about
    // equipment. Writing follows the unit's owning team, because a lifecycle
    // action is a change to that crew's property — a `getAfter()` on the unit
    // is what ties the two together, so an event cannot be filed for a unit the
    // actor could not have moved.

    // A maintenance move covers a batch, so its event names a list of units and
    // the record that moved them. Every other move is one unit, one event.
    function isBatchEvent() {
      return request.resource.data.event_type in
        ['sent_to_maintenance', 'returned_from_maintenance'];
    }

    function assetEventFieldsValid(eventId) {
      return (isBatchEvent()
              ? hasExactly(
                  ['event_id', 'organization_id', 'inventory_item_id', 'inventory_unit_ids',
                   'maintenance_record_id', 'event_type', 'from_status', 'to_status',
                   'actor_uid', 'occurred_at'],
                  ['note'])
              : hasExactly(
                  ['event_id', 'organization_id', 'inventory_item_id', 'inventory_unit_id',
                   'event_type', 'from_status', 'to_status', 'actor_uid', 'occurred_at'],
                  ['using_team_id', 'using_member_uid', 'retirement_reason', 'note']))
        && request.resource.data.event_id == eventId
        && request.resource.data.event_type in
             ['marked_in_use', 'checked_in', 'marked_lost', 'marked_found', 'retired',
              'sent_to_maintenance', 'returned_from_maintenance']
        && request.resource.data.from_status in
             ['available', 'in_use', 'in_maintenance', 'lost', 'retired']
        && request.resource.data.to_status in
             ['available', 'in_use', 'in_maintenance', 'lost', 'retired']
        && request.resource.data.from_status != request.resource.data.to_status
        && (request.resource.data.to_status == 'retired'
            ? ('retirement_reason' in request.resource.data
               && request.resource.data.retirement_reason in
                    ['disposed', 'permanently_lost', 'donated', 'sold', 'other'])
            : !('retirement_reason' in request.resource.data))
        && (!('using_team_id' in request.resource.data)
            || (request.resource.data.using_team_id is string
                && request.resource.data.using_team_id.size() > 0))
        && (!('using_member_uid' in request.resource.data)
            || (request.resource.data.using_member_uid is string
                && request.resource.data.using_member_uid.size() > 0))
        // A member cannot be recorded without the team they had it for.
        && (!('using_member_uid' in request.resource.data)
            || 'using_team_id' in request.resource.data)
        && (!('note' in request.resource.data)
            || (request.resource.data.note is string
                && request.resource.data.note.size() <= 2000))
        && (!isBatchEvent()
            || (request.resource.data.inventory_unit_ids is list
                && request.resource.data.inventory_unit_ids.size() > 0
                && request.resource.data.inventory_unit_ids.size() <= 200
                && request.resource.data.maintenance_record_id is string
                && request.resource.data.maintenance_record_id.size() > 0
                // The verbs and the moves have to agree with each other.
                && (request.resource.data.event_type == 'sent_to_maintenance'
                    ? (request.resource.data.from_status == 'available'
                       && request.resource.data.to_status == 'in_maintenance')
                    : (request.resource.data.from_status == 'in_maintenance'
                       && request.resource.data.to_status == 'available'))))
        && request.resource.data.actor_uid == uid()
        && request.resource.data.occurred_at == request.time;
    }

    /**
     * A batch event, checked against the record it belongs to and one of the
     * units it claims.
     *
     * The maintenance record is read once and carries the authoritative unit
     * list, so the event cannot describe a different batch than the record it
     * names. The sample unit is what proves the batch actually happened rather
     * than being written on its own: an event with no transition behind it
     * fails here.
     *
     * What this does not prove is that *every* listed unit moved. Verifying all
     * of them costs one read each, which is the exact expense this design
     * exists to avoid. Each unit does prove its own membership from its side,
     * so a unit cannot be moved without appearing here — the untestable
     * direction is an event listing a unit that stayed put.
     */
    function batchEventMatchesRecord(data) {
      return existsAfter(maintenancePath(data.maintenance_record_id))
        && getAfter(maintenancePath(data.maintenance_record_id)).data.organization_id
             == data.organization_id
        && getAfter(maintenancePath(data.maintenance_record_id)).data.item_id
             == data.inventory_item_id
        && getAfter(maintenancePath(data.maintenance_record_id)).data
             .get('unit_ids', []) == data.inventory_unit_ids
        && existsAfter(unitPath(data.inventory_unit_ids[0]))
        && getAfter(unitPath(data.inventory_unit_ids[0])).data
             .get('last_lifecycle_event_id', '') == data.event_id
        && getAfter(unitPath(data.inventory_unit_ids[0])).data.status == data.to_status
        && canWriteInventoryForTeam(data.organization_id,
                                    getAfter(unitPath(data.inventory_unit_ids[0])).data.team_id);
    }

    // The unit as it will be once this batch commits. This is what stops an
    // event being filed against a unit the actor has no authority over, and
    // what keeps the log honest: `to_status` has to be what the unit actually
    // became, so a history line cannot claim a move that did not happen.
    function assetEventMatchesUnit(data) {
      return existsAfter(unitPath(data.inventory_unit_id))
        && getAfter(unitPath(data.inventory_unit_id)).data.organization_id == data.organization_id
        && getAfter(unitPath(data.inventory_unit_id)).data.inventory_item_id
             == data.inventory_item_id
        // Where the unit was, and where it ended up. Both, so an event cannot be
        // appended on its own describing a move that already happened or never
        // did: a standalone write leaves the unit where it is, and a unit cannot
        // be in two states at once.
        && exists(unitPath(data.inventory_unit_id))
        && get(unitPath(data.inventory_unit_id)).data.status == data.from_status
        && getAfter(unitPath(data.inventory_unit_id)).data.status == data.to_status
        // And the unit has to point back at this event, which is what stops an
        // extra event riding along with a legitimate transition.
        && getAfter(unitPath(data.inventory_unit_id)).data
             .get('last_lifecycle_event_id', '') == data.event_id
        && canWriteInventoryForTeam(data.organization_id,
                                    getAfter(unitPath(data.inventory_unit_id)).data.team_id);
    }

    match /asset_events/{eventId} {

      allow get, list: if canViewInventory(resource.data.organization_id);

      allow create: if assetEventFieldsValid(eventId)
        && (isBatchEvent()
            ? batchEventMatchesRecord(request.resource.data)
            : assetEventMatchesUnit(request.resource.data));

      // History is what happened. Correcting it would defeat the purpose.
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------- default

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
